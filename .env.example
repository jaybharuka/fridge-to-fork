# Copy to .env and fill in your values
# Get a FREE Google API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Swiggy MCP endpoints (replace with real URLs when available)
SWIGGY_INSTAMART_MCP_URL=http://localhost:8001
SWIGGY_FOOD_MCP_URL=http://localhost:8002

# Delivery address (used when placing orders)
DELIVERY_ADDRESS="123 Main St, Bengaluru 560001"
DELIVERY_LAT=12.9716
DELIVERY_LNG=77.5946

# Swiggy Authentication (Required for Instamart API to bypass WAF)
# Go to swiggy.com, log in, inspect cookies, and copy the _session_id value here.
SWIGGY_SESSION=

