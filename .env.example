# Copy to .env and fill in your values
# Get a FREE Google API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Swiggy MCP endpoints (replace with real URLs when available)
SWIGGY_INSTAMART_MCP_URL=http://localhost:8001
SWIGGY_FOOD_MCP_URL=http://localhost:8002

# Swiggy MCP OAuth 2.1 (PKCE) — required for /auth/login
SWIGGY_CLIENT_ID
# Base URL this app is reachable at, used to build the OAuth redirect_uri
APP_BASE_URL=http://localhost:8000
# Signs session cookies (itsdangerous) — set a long random value in prod
SECRET_KEY=change-me-to-a-random-secret

# Delivery address (used when placing orders)
DELIVERY_ADDRESS="123 Main St, Bengaluru 560001"
DELIVERY_LAT=12.9716
DELIVERY_LNG=77.5946

