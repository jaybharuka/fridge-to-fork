# Copy to .env and fill in your values
# Get a FREE Google API key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...

# Optional multi-key rotation (2026-09) — production vision AND text calls
# try every configured key for a given model before falling to a weaker
# model (see VISION_API_KEYS/_build_vision_clients in step1_fridge_vision.py,
# TEXT_API_KEYS/_build_text_clients in step2_meal_planner.py). Only adds
# real headroom if these belong to SEPARATE Google Cloud projects from
# GOOGLE_API_KEY — Gemini's free-tier daily quota is scoped per project,
# not per key (confirmed by the quota error's own id:
# "GenerateRequestsPerDayPerProjectPerModel-FreeTier"); keys sharing one
# project share its quota and rotation adds nothing. Both optional — the
# app works fine with just GOOGLE_API_KEY.
# GOOGLE_API_KEY_2=AIza...
# GOOGLE_API_KEY_3=AIza...

# Dedicated key for tests/eval_vision_accuracy.py and friends — deliberately
# SEPARATE from GOOGLE_API_KEY/_2/_3. Real bug, 2026-09-27: the eval harness
# sharing production's key meant every test run competed with real users
# for the same daily quota; a real scan hit "0 items detected" during a
# window the harness had been hammering that quota. Required to run the
# eval harness at all — it has no fallback to the production key.
GOOGLE_API_KEY_EVAL=AIza...

# Primary text (meal-planning) model — falls back through chain if quota exhausted
# Chain: gemini-2.5-flash -> gemini-2.5-flash-lite ->
#        gemini-flash-latest -> gemini-flash-lite-latest -> gemini-3.1-pro-preview
# Keep this in sync with TEXT_MODEL_FALLBACK_CHAIN in
# fridge_to_fork/step2_meal_planner.py and the table in README.md — see the
# note below GEMINI_VISION_MODEL on why (same dead-model bug, same fix).
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Primary vision (fridge-scan) model — falls back through chain if quota exhausted.
# Chain: gemini-2.5-flash -> gemini-flash-latest -> gemini-2.5-flash-lite ->
#        gemini-flash-lite-latest -> gemini-3.1-pro-preview
# Keep this in sync with VISION_MODEL_FALLBACK_CHAIN in
# fridge_to_fork/step1_fridge_vision.py and the table in README.md — Google
# has silently retired/access-restricted chain entries before
# (gemini-2.0-flash: 404 "no longer available"; gemini-2.5-pro: 404 "no
# longer available to new users" despite still being listed by
# client.models.list() — listed existence isn't the same as this key
# having access) with nothing surfacing it until someone actually checked.
# Verify against the live API with the real key before changing this again,
# not docs/memory alone.
GEMINI_VISION_MODEL=gemini-2.5-flash

# YouTube Data API v3 key — used by /api/youtube for the "How to make it" video
YOUTUBE_API_KEY=your_key_here

# Spoonacular API key — used by /api/ingredient-image for Top Up product photos
SPOONACULAR_API_KEY=your_key_here

# Unsplash API access key — used by /api/dish-image for the results-page
# hero photo. Get a free one at: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your_key_here

# Swiggy MCP endpoints (used by the Google ADK agent in swiggy_agent.py)
SWIGGY_INSTAMART_MCP_URL=https://mcp.swiggy.com/im
SWIGGY_FOOD_MCP_URL=https://mcp.swiggy.com/food
SWIGGY_DINEOUT_MCP_URL=https://mcp.swiggy.com/dineout

# Google ADK agent model for Swiggy tool selection
# SWIGGY_AGENT_MODEL=gemini-2.5-flash

# Swiggy MCP OAuth 2.1 (PKCE) — client_id comes from Dynamic Client Registration, no env var needed.
# Base URL this app is reachable at, used to build the OAuth redirect_uri (must be whitelisted by Swiggy).
# Keep :8000 when using the vanilla frontend served by app.py directly.
# When running the Next.js frontend (frontend/, dev server on :3000), set
# this to http://localhost:3000 instead, or the Swiggy OAuth callback lands
# the user back on the old :8000 UI. See frontend/README.md.
APP_BASE_URL=http://localhost:8000
# Signs session cookies (itsdangerous) — set a long random value in prod
SECRET_KEY=change-me-to-a-random-secret

# Delivery address (used when placing orders)
DELIVERY_ADDRESS="123 Main St, Bengaluru 560001"
DELIVERY_LAT=12.9716
DELIVERY_LNG=77.5946

